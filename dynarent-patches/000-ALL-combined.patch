diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 4f7e9b6..6bf980c 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -58,6 +58,14 @@ jobs:
       - name: Format check (prettier)
         run: bun run format:check
 
+      # ── Security audit: CVEs conocidos en dependencias npm ──
+      # npm audit consulta la base de datos del npm registry y falla si hay
+      # vulnerabilidades de nivel high o critical. Usa package-lock.json (los
+      # deps son los mismos que en bun.lock). --audit-level=high para no
+      # bloquear el CI por low/moderate que suelen tener workaround.
+      - name: npm audit (high+critical)
+        run: npx npm audit --audit-level=high --omit=dev
+
       - name: Svelte check
         run: bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json
 
@@ -132,3 +140,28 @@ jobs:
           # termina con `exit $LASTEXITCODE`, y tras -SimularFallo (exit 1) el paso saldría
           # con exit 1 aunque ambos casos hayan validado.
           exit 0
+
+  # ── Security audit: CVEs conocidos en dependencias Cargo ──
+  # cargo-audit consulta la base de datos RustSec (RUSTSEC-*) y falla si
+  # alguna dependencia (directa o transitiva) tiene un advisory sin mitigar.
+  # No requiere compilar la app (lee Cargo.lock) → corre en paralelo con
+  # validate y tarda ~30 s.
+  security-audit:
+    name: Security audit (cargo audit)
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Setup Rust
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Install cargo-audit
+        run: cargo install cargo-audit --locked --force
+
+      - name: Run cargo audit
+        working-directory: src-tauri
+        run: cargo audit --deny warnings
