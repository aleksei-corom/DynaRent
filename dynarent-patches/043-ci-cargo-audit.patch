From e8f2acc91d1896f711fb23d423bf6d6764d7bcb6 Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Fri, 28 Aug 2026 14:46:08 +0000
Subject: [PATCH] ci: add cargo-audit step for Rust dependency CVE scanning
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds a new 'security-audit' job to the CI workflow that runs cargo-audit
against src-tauri/Cargo.lock. The job:

- Runs on ubuntu-latest (no Windows needed — cargo-audit reads the lock
  file, it does not compile the app).
- Runs in parallel with the existing 'validate' job.
- Uses --deny warnings so any RustSec advisory (RUSTSEC-*) fails the
  build, not just unmaintained-y crates.

This closes the supply-chain gap: today CI checks formatting, clippy,
tests and builds, but never checks whether any Cargo dependency (direct
or transitive) has a known CVE.
---
 .github/workflows/ci.yml | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 4f7e9b6..44903eb 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -132,3 +132,28 @@ jobs:
           # termina con `exit $LASTEXITCODE`, y tras -SimularFallo (exit 1) el paso saldría
           # con exit 1 aunque ambos casos hayan validado.
           exit 0
+
+  # ── Security audit: CVEs conocidos en dependencias Cargo ──
+  # cargo-audit consulta la base de datos RustSec (RUSTSEC-*) y falla si
+  # alguna dependencia (directa o transitiva) tiene un advisory sin mitigar.
+  # No requiere compilar la app (lee Cargo.lock) → corre en paralelo con
+  # validate y tarda ~30 s.
+  security-audit:
+    name: Security audit (cargo audit)
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Setup Rust
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Install cargo-audit
+        run: cargo install cargo-audit --locked --force
+
+      - name: Run cargo audit
+        working-directory: src-tauri
+        run: cargo audit --deny warnings
-- 
2.47.3

