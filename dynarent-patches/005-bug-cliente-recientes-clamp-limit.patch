From 42594d7b7472e69bca2aa14f8288f9f67b586f10 Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Fri, 28 Aug 2026 15:13:24 +0000
Subject: [PATCH] fix(rust): clamp cliente recientes limit to >=1 to avoid bad
 FIRST clause
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ClienteService::recientes forwarded an unvalidated i64 limit straight to
the repository, which interpolates it into `SELECT FIRST {limit} ...`.
Unlike GastoService::recientes and MantenimientoService::recientes (both
already clamp with limit.max(1)), the cliente path left the door open to
`FIRST 0` (returns zero rows) or `FIRST -N` (Firebird returns all but
the last N rows — surprising semantics).

Apply the same limit.max(1) clamp for consistency and to defend against
callers passing 0 or negatives.
---
 src-tauri/src/services/cliente.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src-tauri/src/services/cliente.rs b/src-tauri/src/services/cliente.rs
index 6224633..9708bea 100644
--- a/src-tauri/src/services/cliente.rs
+++ b/src-tauri/src/services/cliente.rs
@@ -134,7 +134,13 @@ impl ClienteService {
         cipher: &PiiCipher,
         limit: i64,
     ) -> Result<Vec<ClienteConPii>, AppError> {
-        let raw = ClienteRepository::recientes(conn, limit)?;
+        // Acota el limite igual que MantenimientoService::recientes y
+        // GastoService::recientes: la query usa `FIRST {limit}` interpolado
+        // en SQL (rsfbclient no soporta `?` para FIRST/ROWS), y un limite
+        // <= 0 produce `FIRST 0` (0 filas) o `FIRST -N` (todas menos las
+        // ultimas N, semantica rara de Firebird). max(1) garantiza un minimo
+        // sensato sin cambiar el comportamiento para callers validos.
+        let raw = ClienteRepository::recientes(conn, limit.max(1))?;
         Ok(raw.into_iter().map(|c| descifrar(cipher, c)).collect())
     }
 }
