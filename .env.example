# DynaRent ERP — variables de entorno opcionales
# (el sistema usa data/config.ini por defecto; estas vars SOLO Override config.ini
# si están set y NO vacías. El override es en memoria: no se escriben en config.ini.)

# Clave de cifrado PII (AES-256-GCM, base64 de 32 bytes). Generar con:
#   openssl rand -base64 32
DYNARENT_DB_ENCRYPTION_KEY=

# Credenciales Firebird (embedded por defecto; usar solo si se migra a server)
DYNARENT_FB_USER=sysdba
DYNARENT_FB_PASSWORD=
